<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandboxed: Reelmark can only touch files the user drops in or chooses. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Outgoing connections only, used solely for api.themoviedb.org.
	     No incoming connections (no network.server). -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Read and move the files the user drops or opens, and write into the
	     library folders they choose. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Remember the chosen library folders between launches. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
